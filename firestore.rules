rules_version = '2';

// リアルタイム共有（Issue #43）
// - 匿名認証済みユーザーのみアクセス可能
// - セッションコードを知っていれば読み取り可（一覧取得は不可）
// - 書き込みは作成者（ホスト）のみ、有効期限内のみ
// - 作成時は進行中（ended == false）と終了済みゲームの共有（ended == true、Issue #46）の両方を許可
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['data', 'hostUid', 'createdAt', 'updatedAt', 'expiresAt', 'ended'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(49, 'h')
        && request.resource.data.ended is bool;

      allow update: if request.auth != null
        && resource.data.hostUid == request.auth.uid
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt', 'ended'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000
        && request.resource.data.ended is bool;

      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
  }
}
